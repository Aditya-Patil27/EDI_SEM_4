# ── Datasets (large — download separately, regenerate at build) ──
data/raw/
data/engineered/
data/processed/

# ── Trained models (binary, regenerated by train_pipeline.py) ──
models/companies/*.pkl
models/company_classifier.pth
models/company_classifier_transfer.pth
models/*.onnx
models/*.h5

# Keep the __init__.py and manifest (small text)
!models/__init__.py
!models/companies/manifest.json

# ── Reports / Eval artifacts (regenerated each run) ──
evaluation_report.json
classifier_report.json
*.htmlcov/
*.coverage

# ── Python bytecode ──
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Test cache ──
.pytest_cache/
.cache/

# ── Runtime logs ──
logs/
*.log

# ── Jupyter ──
notebooks/.ipynb_checkpoints/
notebooks/*/.ipynb_checkpoints/
.ipynb_checkpoints/

# ── IDE / OS ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# ── Environment ──
.env
.env.local
*.venv
venv/
.venv/
ENV/
env/

# ── Python packages ──
*.egg-info/
*.egg
dist/
build/
.eggs/
